# Proyecto: Canarias Conecta
# Integrantes: Estela Fernandez Trujillo, Airam Prieto Gonzalez, Sergio Gonzalez Sanchez
# Funcion: Ejemplo de variables de entorno del servidor.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/canarias_conecta
JWT_SECRET=change-this-for-local-development

# URL del cliente, para construir los enlaces de los correos
CLIENT_URL=http://localhost:5173

# Correo saliente (SMTP). Sin SMTP_HOST, en desarrollo los correos se muestran en la consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Canarias Conecta <no-responder@canariasconecta.local>

